import json
import os
import secrets
from pathlib import Path

os.umask(0o077)
env = Path("database.env")
if not env.exists():
    env.write_text("POSTGRES_PASSWORD=" + secrets.token_hex(32) + "\n")
password = env.read_text().strip().split("=", 1)[1]
Path("wiki-config.yml").write_text(json.dumps({
    "port": 3000,
    "db": {"host": "127.0.0.1", "port": 5432, "user": "postgres",
           "pass": password, "db": "wikijs", "schema": "wiki", "ssl": False},
}))
