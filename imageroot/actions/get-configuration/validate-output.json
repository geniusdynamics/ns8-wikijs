{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Get wikijs settings",
    "$id": "http://nethserver.org/json-schema/task/output/wikijs/get-configuration",
    "description": "Get wikijs settings",
    "examples": [
        {
            "host": "wikijs.domain.org",
            "http2https": true,
            "lets_encrypt": true
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'wikijs.domain.org'",
            "format": "hostname"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "ldap_domains": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "oidc_providers": {
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "ldap_domain": {
                    "type": "string",
                    "maxLength": 253
                },
                "oidc_domain": {
                    "type": "string",
                    "maxLength": 253
                },
                "provider": {
                    "type": "string",
                    "maxLength": 128
                },
                "issuer": {
                    "type": "string",
                    "maxLength": 2048
                },
                "client_id": {
                    "type": "string",
                    "maxLength": 255
                },
                "oidc_mode": {
                    "enum": [
                        "off",
                        "ns8",
                        "manual"
                    ]
                },
                "registration": {
                    "type": "boolean"
                },
                "callback_url": {
                    "type": "string"
                },
                "client_secret_set": {
                    "type": "boolean",
                    "description": "True when a client secret is stored. The secret itself is never returned."
                },
                "trusted_email": {
                    "type": "boolean"
                }
            }
        },
        "sites": {
            "type": "array",
            "maxItems": 30,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "host",
                    "lets_encrypt"
                ],
                "properties": {
                    "host": {
                        "type": "string",
                        "format": "hostname",
                        "pattern": "^[a-zA-Z0-9.-]+\\.[a-zA-Z0-9-]+$"
                    },
                    "lets_encrypt": {
                        "type": "boolean"
                    }
                }
            }
        },
        "admin_email": {
            "type": "string"
        },
        "admin_password_set": {
            "type": "boolean",
            "description": "True when an administrator password is stored. The password itself is never returned."
        }
    }
}
