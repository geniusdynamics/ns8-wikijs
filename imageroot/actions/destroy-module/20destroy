# Remove the primary Traefik route and the additional site routes

import os
import sys

import agent
import agent.tasks
from wikijs_routes import delete, saved

traefik_id = agent.resolve_agent_id("traefik@node")
if traefik_id:
    response = agent.tasks.run(agent_id=traefik_id, action="delete-route",
                               data={"instance": os.environ["MODULE_ID"]},
                               extra={"isNotificationHidden": True})
    if response["exit_code"] != 0:
        print(agent.SD_WARNING + "Could not remove the Wiki.js Traefik route", file=sys.stderr)

for row in saved():
    delete(row["host"])
