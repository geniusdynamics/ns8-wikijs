# Store the Wiki.js administrator credentials in state/admin.env (0600).
# Wiki.js creates the first administrator from them on its first start;
# 85apply_after_start writes later changes to the existing account.

import json
import sys

from wikijs_admin import store, validate

values = validate(json.load(sys.stdin))
if values:
    store(values)
