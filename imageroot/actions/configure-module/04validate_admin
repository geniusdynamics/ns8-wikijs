# Validate the Wiki.js administrator email and password. Never echo the password.

import json
import sys

import agent
from wikijs_admin import AdminError, validate

agent.set_weight(__file__.rsplit("/", 1)[-1], 0)

try:
    validate(json.load(sys.stdin))
except AdminError as error:
    agent.set_status("validation-failed")
    json.dump([{"field": error.field, "parameter": error.field, "value": "", "error": error.key}],
              sys.stdout)
    sys.exit(4)
