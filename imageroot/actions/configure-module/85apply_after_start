# After Wiki.js is running with an initialized database:
# - write a changed administrator email or password to the root administrator;
# - restart Wiki.js once if the sign-in strategies could not be written before
#   its first start (it loads them at boot).

import subprocess
import sys

import agent
import wikijs_admin
import wikijs_auth

def wait():
    if subprocess.run(["wikijs-wait-ready", "300"]).returncode != 0:
        print(agent.SD_ERR + "Wiki.js is not ready", file=sys.stderr)
        sys.exit(1)

wait()
if wikijs_admin.apply():
    print("Wiki.js administrator account updated", file=sys.stderr)
if wikijs_auth.PENDING.exists():
    subprocess.run(["systemctl", "--user", "restart", "wikijs-app.service"], check=True)
    wait()
    if wikijs_auth.PENDING.exists():
        print(agent.SD_ERR + "NS8 sign-in strategies could not be applied", file=sys.stderr)
        sys.exit(1)
