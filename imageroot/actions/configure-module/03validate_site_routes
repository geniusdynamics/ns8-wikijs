#!/usr/bin/env python3
import json
import sys

import agent
from wikijs_routes import check

try:
    check(json.load(sys.stdin))
except ValueError as error:
    agent.set_status("validation-failed")
    json.dump([{"field": "sites", "parameter": "sites", "value": "", "error": "invalid_sites",
                "details": str(error)}], sys.stdout)
    sys.exit(3)
