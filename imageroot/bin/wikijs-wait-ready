#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Wait until Wiki.js answers its readiness probe and its database is initialized.

import os
import sys
import time
import urllib.request

from wikijs_auth import database_ready

timeout = int(sys.argv[1]) if len(sys.argv) > 1 else 300
deadline = time.monotonic() + timeout
url = f"http://127.0.0.1:{os.environ['TCP_PORT']}/_ready"
while time.monotonic() < deadline:
    try:
        with urllib.request.urlopen(url, timeout=5) as response:
            if response.status == 200 and database_ready():
                sys.exit(0)
    except Exception:
        pass
    time.sleep(3)
print("Wiki.js did not become ready in time", file=sys.stderr)
sys.exit(1)
